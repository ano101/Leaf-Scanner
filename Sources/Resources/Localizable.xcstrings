    "settings.expiry.hint": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если приложение найдёт в документе дату окончания действия, оно напомнит за три месяца, за месяц и за неделю. Даты ищутся на устройстве, как и весь остальной разбор."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app finds an expiry date in a document, it reminds you three months, one month and one week ahead. Dates are found on the device, like all the rest of the processing."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба құжаттан мерзім аяқталу күнін тапса, үш ай, бір ай және бір апта бұрын еске салады. Күндер, қалған барлық талдау сияқты, құрылғыда ізделеді."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо застосунок знайде в документі дату завершення дії, він нагадає за три місяці, за місяць і за тиждень. Дати шукаються на пристрої, як і весь інший розбір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama belgede bir son geçerlilik tarihi bulursa üç ay, bir ay ve bir hafta önce hatırlatır. Tarihler, diğer tüm işlemler gibi, cihazda bulunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die App in einem Dokument ein Ablaufdatum, erinnert sie drei Monate, einen Monat und eine Woche vorher. Die Daten werden auf dem Gerät gefunden, wie die gesamte übrige Verarbeitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’app trouve une date d’expiration dans un document, elle vous le rappelle trois mois, un mois et une semaine avant. Les dates sont trouvées sur l’appareil, comme tout le reste du traitement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app encuentra una fecha de caducidad en un documento, avisa tres meses, un mes y una semana antes. Las fechas se buscan en el dispositivo, igual que todo el resto del procesamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o app encontrar uma data de validade no documento, ele avisa três meses, um mês e uma semana antes. As datas são encontradas no aparelho, como todo o restante do processamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果应用在文稿中找到有效期，会在三个月、一个月和一周前提醒您。日期与其余处理一样，都在设备上完成。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا وجد التطبيق تاريخ انتهاء في المستند، فسيذكّرك قبل ثلاثة أشهر وشهر وأسبوع. تُستخرج التواريخ على الجهاز، مثل بقية المعالجة."
          }
        }
      }
    },
