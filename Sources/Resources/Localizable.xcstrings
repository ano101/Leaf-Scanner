    "archive.search.empty.message": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно снять его прямо сейчас — распознавание найдёт текст само."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can scan it right now — the text will be recognised for you."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оны дәл қазір түсіруге болады — мәтінді тану өзі табады."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна зняти його просто зараз — розпізнавання знайде текст саме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen şimdi tarayabilirsiniz — metni tanıma kendisi bulur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können es sofort scannen — die Texterkennung findet den Text von selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le numériser tout de suite — la reconnaissance trouvera le texte elle-même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede escanearlo ahora mismo: el reconocimiento encontrará el texto por sí solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode digitalizá-lo agora mesmo — o reconhecimento acha o texto sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
