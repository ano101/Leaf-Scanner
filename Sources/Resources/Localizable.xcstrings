    "settings.expiry": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминать о сроках"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind about expiry dates"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
