        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with Face ID or the device passcode. The archive locks again every time the app goes to the background."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID немесе құрылғы коды арқылы кіру. Қолданба фоннан оралған сайын мұрағат қайта жабылады."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід за Face ID або кодом пристрою. Архів замикається знову щоразу після повернення з фону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID veya cihaz parolasıyla giriş. Uygulama arka plandan her dönüşte arşiv yeniden kilitlenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugang mit Face ID oder Gerätecode. Das Archiv sperrt sich bei jeder Rückkehr aus dem Hintergrund erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès par Face ID ou code de l’appareil. L’archive se verrouille de nouveau à chaque retour depuis l’arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso con Face ID o el código del dispositivo. El archivo vuelve a bloquearse cada vez que la app regresa del segundo plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso por Face ID ou código do aparelho. O arquivo se bloqueia de novo sempre que o app volta do segundo plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过面容 ID 或设备密码进入。每次从后台返回，档案都会重新锁定。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدخول عبر Face ID أو رمز الجهاز. يُقفل الأرشيف من جديد في كل مرة يعود فيها التطبيق من الخلفية."
          }
        }
      }
    },
    "settings.privacy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на устройстве"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this device"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі құрылғыда қалады"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе лишається на пристрої"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey cihazda kalır"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf dem Gerät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur l’appareil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en el dispositivo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica no aparelho"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在设备上"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على الجهاز"
          }
        }
      }
    },
    "settings.privacy.hint": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не делает ни одного сетевого запроса. Ни документы, ни распознанный текст никуда не отправляются — отправлять их некуда."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app makes no network requests at all. Neither documents nor recognised text go anywhere — there is nowhere for them to go."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданба бірде-бір желілік сұрау жасамайды. Құжаттар да, танылған мәтін де еш жерге жіберілмейді — жіберетін жер жоқ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок не робить жодного мережевого запиту. Ні документи, ні розпізнаний текст нікуди не надсилаються — надсилати їх нікуди."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hiçbir ağ isteği yapmaz. Ne belgeler ne de tanınan metin hiçbir yere gönderilmez — gönderilecek bir yer yoktur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App stellt keine einzige Netzwerkanfrage. Weder Dokumente noch erkannter Text gehen irgendwohin — es gibt keinen Ort, wohin sie gehen könnten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne fait aucune requête réseau. Ni les documents ni le texte reconnu ne partent où que ce soit — il n’y a nulle part où les envoyer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no hace ni una sola petición de red. Ni los documentos ni el texto reconocido van a ninguna parte: no hay adónde enviarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não faz nenhuma requisição de rede. Nem os documentos nem o texto reconhecido vão a lugar algum — não há para onde enviá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不发出任何网络请求。文稿和识别出的文字都不会发往任何地方——根本无处可发。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجري التطبيق أي طلب شبكة. لا المستندات ولا النص المتعرَّف عليه يذهب إلى أي مكان — لا يوجد مكان يُرسل إليه."
          }
        }
      }
    },
