    "export.suggestion": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В цвете такой вес недостижим. В сером получится."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This size is out of reach in colour. Gray will fit."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түрлі-түсті түрде мұндай салмаққа жету мүмкін емес. Сұр түрде шығады."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кольорі такої ваги не досягти. У сірому вийде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkli olarak bu boyuta ulaşılamaz. Gri tonlamada olur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Farbe ist diese Größe nicht erreichbar. In Graustufen schon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En couleur, cette taille est hors d’atteinte. En gris, elle passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En color no se alcanza ese tamaño. En gris sí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em cores esse tamanho não dá. Em cinza dá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩色达不到这个大小，灰度可以。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحجم غير ممكن بالألوان. بالرمادي ممكن."
