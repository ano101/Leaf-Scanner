    "archive.empty.message": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на этом устройстве. Ни одного сетевого запроса, ни одного аккаунта."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this device. No network requests, no accounts."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бәрі осы құрылғыда қалады. Бірде-бір желілік сұрау жоқ, бірде-бір тіркелгі жоқ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе лишається на цьому пристрої. Жодного мережевого запиту, жодного облікового запису."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu cihazda kalır. Tek bir ağ isteği yok, tek bir hesap yok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät. Keine einzige Netzwerkanfrage, kein einziges Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil. Aucune requête réseau, aucun compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo. Ni una sola petición de red, ni una sola cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste aparelho. Nenhuma requisição de rede, nenhuma conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在这台设备上。没有任何网络请求，也没有任何账号。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى على هذا الجهاز. لا طلب شبكة واحد، ولا حساب واحد."
          }
        }
      }
    },
