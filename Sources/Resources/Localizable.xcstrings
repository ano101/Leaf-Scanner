    "document.redaction.hint": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдены личные данные. Нажмите на рамку, чтобы закрыть их насовсем, или обведите своё место пальцем."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal data found. Tap a frame to remove it for good, or draw your own area."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеке деректер табылды. Оларды біржола жабу үшін жақтауды басыңыз немесе өз жеріңізді саусақпен сызыңыз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдено особисті дані. Натисніть на рамку, щоб закрити їх назавжди, або обведіть своє місце пальцем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel veri bulundu. Kalıcı olarak kapatmak için çerçeveye dokunun ya da kendi alanınızı parmağınızla çizin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Daten gefunden. Tippen Sie auf den Rahmen, um sie endgültig zu entfernen, oder umranden Sie eine eigene Stelle mit dem Finger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données personnelles détectées. Touchez le cadre pour les effacer définitivement, ou entourez votre propre zone du doigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han detectado datos personales. Toque el marco para borrarlos para siempre, o rodee su propia zona con el dedo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados pessoais encontrados. Toque no quadro para apagá-los de vez, ou contorne sua própria área com o dedo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现个人信息。点按方框可将其彻底抹去，也可以用手指圈出自己的区域。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُثر على بيانات شخصية. المس الإطار لإزالتها نهائيًا، أو ارسم منطقتك بإصبعك."
          }
        }
      }
    },
