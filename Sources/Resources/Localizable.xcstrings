    "export.password.hint": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только латинские буквы и цифры — так устроен формат PDF. Пароль нигде не сохраняется: забытый восстановить нельзя."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latin letters and digits only — that is how PDF works. The password is never stored: a forgotten one cannot be recovered."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек латын әріптері мен цифрлар — PDF пішімі осылай жасалған. Құпия сөз еш жерде сақталмайды: ұмытылғанын қалпына келтіру мүмкін емес."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише латинські літери та цифри — так влаштований формат PDF. Пароль ніде не зберігається: забутий відновити неможливо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Latin harfleri ve rakamlar — PDF biçimi böyle çalışır. Parola hiçbir yerde saklanmaz: unutulanı geri getirmek mümkün değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lateinische Buchstaben und Ziffern — so funktioniert das PDF-Format. Das Passwort wird nirgends gespeichert: ein vergessenes lässt sich nicht wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettres latines et chiffres uniquement — c’est ainsi que fonctionne le format PDF. Le mot de passe n’est stocké nulle part : oublié, il est irrécupérable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo letras latinas y cifras: así funciona el formato PDF. La contraseña no se guarda en ningún sitio: si se olvida, no se puede recuperar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas letras latinas e números — é assim que o formato PDF funciona. A senha não é guardada em lugar algum: esquecida, não há como recuperá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限拉丁字母和数字——PDF 格式如此规定。密码不会保存在任何地方：忘记后无法找回。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حروف لاتينية وأرقام فقط — هكذا تعمل صيغة PDF. لا تُحفظ كلمة السر في أي مكان: المنسية لا يمكن استعادتها."
          }
        }
      }
    },
